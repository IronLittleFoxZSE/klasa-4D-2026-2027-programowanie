<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SimpleBindingCalculatorMauiApp.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="thisPage"
             BindingContext="{x:Reference thisPage}">

    <StackLayout Orientation="Vertical" Spacing="20">
        <Label BackgroundColor="#E62121"
               FontAttributes="Bold"
               FontSize="20"
               Text="Podaj pierwszą liczbę:" />
        <Entry Text="{Binding FirstStrNumber}" />

        <Label BackgroundColor="#E62121"
               FontAttributes="Bold"
               FontSize="20"
               Text="Podaj drugą liczbę:" />
        <Entry Text="{Binding SecondStrNumber}" />

        <Button Clicked="Button_Clicked" Text="Oblicz" />

        <Label BackgroundColor="{Binding ColorResult}" Text="{Binding Result}" />
    </StackLayout>

</ContentPage>
